# Database
DATABASE_URL=mysql+aiomysql://db_user:db_password@db-host:3306/db_name

# Secrets (generate with: openssl rand -hex 32)
JWT_SECRET=change-me
ENCRYPTION_KEY=change-me

# App
APP_ROOT_PATH=/mapper-new
PORT=2528

# Auth service
AUTH_BASE_URL="https://your-api-host.example.com:9001/auth"
UPSTREAM_AUTH_URL=https://your-api-host.example.com:9001/auth/auth1/login
UPSTREAM_AUTH_EMAIL=admin@example.com
UPSTREAM_AUTH_PASSWORD=change-me
UPSTREAM_AUTH_DECRYPTION_KEY="change-me"

# Upstream API tokens (format: domain=token, comma-separated for multiple)
UPSTREAM_API_TOKENS=example.com=your-token-here

# Audit detail store (MongoDB) -- REQUIRED, no built-in default.
# The legacy gateway writes a full-detail document per call; the log views read
# it to fill in headers, the query string and the captured log. The service
# refuses to start if any of the three is missing, rather than falling back to
# a host that would leave the detail blocks silently empty.
AUDIT_MONGO_ENABLED=true
AUDIT_MONGO_URI=mongodb://mongo-host.example.com:27017/
AUDIT_MONGO_DATABASE=gateway_logs_db
AUDIT_MONGO_COLLECTION=api_gateway_logs
# Leave unset for automatic: the service only mirrors its own calls to MongoDB
# when api_call_log is missing the header columns (e.g. a MySQL account that
# cannot ALTER TABLE). Set true/false to force the choice either way.
# AUDIT_MONGO_MIRROR=true
