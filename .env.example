# ============================================================================
# API Mapper & Gateway — environment template
#
# Copy this file to `.env` in the project root and fill in real values:
#     cp .env.example .env
#
# The backend loads `.env` relative to the working directory it is started
# from, so always run uvicorn from the project root:
#     uvicorn backend.main:app --reload
# ============================================================================

# --- Database ----------------------------------------------------------------
# Async PostgreSQL DSN (asyncpg driver). Works against a local PostgreSQL
# server or a Supabase connection string (take the "Session pooler" DSN and
# swap the scheme to postgresql+asyncpg://).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/api_mapper

# --- Security -----------------------------------------------------------------
# Secret used to sign JWTs. REQUIRED — app refuses to start without it.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# JWT signing algorithm and token lifetime, in hours.
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=24

# AES-256-GCM key used to encrypt stored credentials (SFTP passwords, API
# secrets) at rest. REQUIRED — app refuses to start without it.
# Accepts a hex string or an arbitrary passphrase.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_KEY=

# --- HTTP ----------------------------------------------------------------------
# Allowed CORS origins. Use "*" for all, or a comma-separated list, e.g.
# CORS_ORIGINS=http://localhost:5173,https://app.example.com
CORS_ORIGINS=*

# Timeout, in seconds, applied to upstream auth and proxy calls.
API_TIMEOUT_SECONDS=60

# --- Upstream authentication (protected APIs) -----------------------------------
# Some target APIs reject calls without a bearer token. When all three variables
# below are set, the gateway lazily logs in on first use (POSTs email/password to
# UPSTREAM_AUTH_URL), caches the returned token, and injects it as
# "Authorization: Bearer <token>" on upstream calls that carry no explicit
# Authorization / X-Api-Token header of their own.
#
#   UPSTREAM_AUTH_URL      -> the login endpoint that returns a token
#   UPSTREAM_AUTH_EMAIL    -> login email/username
#   UPSTREAM_AUTH_PASSWORD -> login password
#
# Optional overrides (defaults shown):
#   UPSTREAM_AUTH_USERNAME_FIELD=email        # body field carrying the username
#   UPSTREAM_AUTH_PASSWORD_FIELD=password     # body field carrying the password
#   UPSTREAM_AUTH_LOGIN_CONTENT_TYPE=json     # "json" or "form" request body
#   UPSTREAM_AUTH_HEADER_NAME=Authorization   # "X-Api-Token" to use that header
#   UPSTREAM_AUTH_TOKEN_PREFIX=Bearer         # "" sends the token as-is
#   UPSTREAM_AUTH_TOKEN_KEYS=[...]            # JSON array of token keys/paths
#   UPSTREAM_AUTH_EXPIRY_KEYS=[...]           # JSON array of expiry keys/paths
#   UPSTREAM_AUTH_MIN_TTL_SECONDS=60          # refresh ahead of real expiry
UPSTREAM_AUTH_URL=
UPSTREAM_AUTH_EMAIL=
UPSTREAM_AUTH_PASSWORD=

# --- Upstream authentication encryption (encrypted login request/response) -----
# Endpoints such as SSPA/IMIS accept ONLY an encrypted request and return ONLY an
# encrypted response. Set UPSTREAM_AUTH_DECRYPTION_KEY below; the gateway uses it
# as the shared AES-256-GCM symmetric key to (a) encrypt the login request and
# (b) decrypt the login response — each value is base64 of
# nonce(12) + tag(16) + ciphertext, exactly matching the server's
# app/helper/aes.py (the server ignores AES_IV for GCM, so no IV is used here).
# The key must be the server's AES_SECRET_KEY and resolve to exactly 32 bytes:
# base64, hex, or a plain 32-char string (no hashing/derivation).
#   UPSTREAM_AUTH_DECRYPTION_KEY=             # server's AES_SECRET_KEY
#   UPSTREAM_AUTH_ENCRYPTED_FIELD=encrypted_data
UPSTREAM_AUTH_DECRYPTION_KEY=
UPSTREAM_AUTH_ENCRYPTED_FIELD=encrypted_data
# --- Upstream static API tokens (host-scoped) -----------------------------------
# Some upstreams do NOT use the login above; they expect a fixed API token
# (Authorization: Bearer <token> or X-Api-Token). Map each upstream host to its
# token below so the gateway sends the right credential per destination. A host
# that matches wins over the shared login token; other hosts still use the login.
# Accepts host=token pairs (comma-separated) or a JSON object.
#   UPSTREAM_API_TOKENS=mamtasaath.com=<token>,api.other.example=<token>
UPSTREAM_API_TOKENS=
